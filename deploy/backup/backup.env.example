# Swiper Store — backup configuration.
# Copy to /etc/swiperstore/backup.env (mode 0640, owner root:swiperstore)
# and fill in the values. Never commit a filled copy.

# Required.
DATABASE_URL=postgres://swiperstore:CHANGE_ME@127.0.0.1:5432/swiperstore
UPLOAD_DIR=/srv/swiperstore/shared/storage/uploads
BACKUP_ROOT=/var/backups/swiperstore

# Optional. Defaults to the "trash" sibling of UPLOAD_DIR.
# TRASH_DIR=/srv/swiperstore/shared/storage/trash

# Optional retention counts.
RETENTION_DAILY=14
RETENTION_WEEKLY=8
RETENTION_MONTHLY=6

# Optional encrypted offsite copy. OFFSITE_DIR must be a mounted remote
# (rclone mount, sshfs) and AGE_RECIPIENT an age public key.
# OFFSITE_DIR=/mnt/offsite/swiperstore
# AGE_RECIPIENT=age1...

# Only for verify-restore.sh: a scratch URL ending in _restore_check.
# RESTORE_DATABASE_URL=postgres://swiperstore:CHANGE_ME@127.0.0.1:5432/swiperstore_restore_check
# RESTORE_MAINTENANCE_URL=postgres://swiperstore:CHANGE_ME@127.0.0.1:5432/postgres
