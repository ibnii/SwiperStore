# Copy to .env.local and fill in real values. Never commit .env.local.
DATABASE_URL=postgres://swiperstore:change-me@127.0.0.1:5432/swiperstore

# Dedicated test database; its name must end with "_test".
DATABASE_URL_TEST=postgres://swiperstore:change-me@127.0.0.1:5432/swiperstore_test

ADMIN_EMAIL=admin@example.com
# Argon2id hash from `npm run hash-password -- '<password>'`.
# Escape every "$" as "\$" when the value is loaded from a shell/systemd env file.
ADMIN_PASSWORD_HASH=\$argon2id\$v=19\$m=19456,t=2,p=1\$...
WA_NUMBER=628xxxxxxxxxx
UPLOAD_DIR=./storage/uploads
SITE_URL=http://localhost:3000

# Optional: password used by Playwright E2E admin login.
E2E_ADMIN_PASSWORD=
